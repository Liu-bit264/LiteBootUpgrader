# ---- Python ----
__pycache__/
*.py[cod]
.venv/

# ---- PyInstaller 构建产物（dist/ 不入库，见 build_exe.bat） ----
build/
dist/
*.spec

# ---- 本地工具状态 ----
.mimosa/
.zcode/

# ---- 密钥材料（ADR-020：任何形态不入库，见 README「签名验签升级」） ----
# keygen 默认把私钥写成 ./sign_test_key.pem（生成在仓库根，必须忽略）
*.pem
*.key
bl_sign_pubkey_local.h
**/bl_sign_pubkey_local.h

# ---- 评审过程记录（本地保留，不入库） ----
docs/review/

# ---- 工厂模式本地数据（工具旁，不入库；示例见 factory/local.example.json） ----
# 产线配置（镜像预设/记录路径/芯片覆盖）、结果记录、量产镜像按约定不入库
factory/local.json
factory/records/
factory/images/**/*.bin
